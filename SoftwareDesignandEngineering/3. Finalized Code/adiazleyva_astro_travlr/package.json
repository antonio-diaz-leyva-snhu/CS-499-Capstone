{
  "name": "travlr-astro",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "check": "astro check",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "astro": "astro",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "astro": "^7.4.0",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
