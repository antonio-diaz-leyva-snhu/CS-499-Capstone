---
// Wraps BaseLayout for the admin area and shows who is signed in (replaces the Angular
// shell). The sign-out button is a POST form, so a link on another site cannot trigger it.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
}
const { title = 'Admin | Travlr Getaways' } = Astro.props;
const user = Astro.locals.user;
---

<BaseLayout title={title}>
  <link slot="head" rel="stylesheet" href="/css/admin.css" />
  {
    user && (
      <div class="admin-bar">
        <span>Signed in as {user.name}</span>
        <form method="post" action="/api/logout">
          <button type="submit">Sign out</button>
        </form>
      </div>
    )
  }
  <div id="contents">
    <div class="box">
      <div>
        <div class="body">
          <slot />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
