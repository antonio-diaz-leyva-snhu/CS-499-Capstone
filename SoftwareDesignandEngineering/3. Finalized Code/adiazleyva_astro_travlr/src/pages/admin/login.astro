---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { attemptLogin } from '../../lib/session';
import { COOKIE_NAME, cookieOptions } from '../../lib/config.ts';

export const prerender = false;

if (Astro.locals.user) return Astro.redirect('/admin', 303);

let message = '';
let email = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const rawEmail = form.get('email');
  email = typeof rawEmail === 'string' ? rawEmail : '';
  const result = await attemptLogin(email, form.get('password'), Astro.clientAddress);
  if (result.ok) {
    Astro.cookies.set(COOKIE_NAME, result.token, cookieOptions());
    return Astro.redirect('/admin', 303);
  }
  message = result.message;
}
---

<BaseLayout title="Admin sign in | Travlr Getaways">
  <link slot="head" rel="stylesheet" href="/css/admin.css" />
  <div id="contents">
    <div class="box">
      <div>
        <div class="body">
          <h1>Admin sign in</h1>
          {message && <p class="admin-alert" role="alert">{message}</p>}
          <form method="post" class="admin-form">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value={email} autocomplete="username" required />
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
            <div class="admin-actions"><button type="submit">Sign in</button></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
