---
// Replaces partials/footer.hbs. Also fixes the original's broken Meals link
// (its href was wrapped in curly quotes).
import { navLinks, isCurrent } from '../lib/nav';
const path = Astro.url.pathname;
---

<div id="footer">
  <div>
    <ul class="navigation">
      {
        navLinks.map((link) => (
          <li class={isCurrent(link.href, path) ? 'active' : undefined}>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
    <div id="connect">
      <a href="http://pinterest.com/fwtemplates/" target="_blank" rel="noopener" class="pinterest"></a>
      <a href="http://freewebsitetemplates.com/go/facebook/" target="_blank" rel="noopener" class="facebook"></a>
      <a href="http://freewebsitetemplates.com/go/twitter/" target="_blank" rel="noopener" class="twitter"></a>
      <a href="http://freewebsitetemplates.com/go/googleplus/" target="_blank" rel="noopener" class="googleplus"></a>
    </div>
  </div>
  <p>© 2023 by Travlr Getaways. All Rights Reserved</p>
</div>
